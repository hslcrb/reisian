{
  "name": "reisian",
  "version": "0.1.0",
  "private": true,
  "description": "An expressive, accessible, visual-only website studio.",
  "author": "Reisian contributors",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "desktop": "electron .",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "package": "npm run build && electron-builder --config electron-builder.config.cjs --linux --dir",
    "package:win": "npm run build && electron-builder --config electron-builder.config.cjs --win portable"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "^0.577.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "latest",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "@playwright/test": "latest",
    "@axe-core/playwright": "latest",
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
